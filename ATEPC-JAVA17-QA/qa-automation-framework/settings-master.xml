<?xml version="1.0" encoding="UTF-8"?>
<settings
	xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd"
	xmlns="http://maven.apache.org/SETTINGS/1.1.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
 
  <localRepository>${user.home}/.m2/MASTER_repo</localRepository>
  <proxies>
    <proxy>
      <active>true</active>
      <protocol>http</protocol>
      <host>bos-proxy.ext.ray.com</host>
      <port>80</port>
    </proxy>
  </proxies>
	<profiles>
		<profile>
			<id>MASTER-test</id>
		</profile>
	</profiles>
	<activeProfiles>
		<activeProfile>MASTER-test</activeProfile>
	</activeProfiles>
</settings>
